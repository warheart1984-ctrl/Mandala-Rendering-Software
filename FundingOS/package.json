{
  "name": "@fundingos/core",
  "version": "0.1.0",
  "description": "FundingOS - AI-Operated Funding Department with MRS Crew Integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fundingos": "dist/cli/fundingos-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:conformance": "vitest run test/conformance",
    "test:integration": "vitest run test/integration",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "fundingos": "node dist/cli/fundingos-cli.js",
    "dev": "tsx cli/fundingos-cli.ts"
  },
  "keywords": ["funding", "grants", "ai", "governance", "mrs"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "tsx": "^4.6.0"
  }
}