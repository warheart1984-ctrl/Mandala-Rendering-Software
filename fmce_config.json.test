  "roles": {
    "chat": {
      "role": "chat",
      "model": "openrouter/meta-llama/llama-3.1-70b-instruct",
      "fallback": "ollama/llama3.2:3b",
      "temperature": 0.7,
      "max_tokens": 8192,
      "extra_params": {}
    },
    "code": {
      "role": "code",
      "model": "openrouter/deepseek/deepseek-coder",
      "fallback": "ollama/codellama:7b",
      "temperature": 0.7,
      "max_tokens": 8192,
      "extra_params": {}
    },
    "reasoning": {
      "role": "reasoning",
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b",
      "fallback": "openrouter/nvidia/nemotron-3-super-120b-a12b",
      "temperature": 0.7,
      "max_tokens": 8192,
      "extra_params": {}
    },
    "vision": {
      "role": "vision",
      "model": "openrouter/meta-llama/llama-3.2-11b-vision-instruct",
      "fallback": "ollama/llava:7b",
      "temperature": 0.7,
      "max_tokens": 8192,
      "extra_params": {}
    },
    "embeddings": {
      "role": "embeddings",
      "model": "openrouter/BAAI/bge-large-en-v1.5",
      "fallback": "ollama/nomic-embed-text",
      "temperature": 0.7,
      "max_tokens": 8192,
      "extra_params": {}
    },
    "images": {
      "role": "images",
      "model": "lemonade/SD-Turbo",
      "fallback": "openrouter/stability-ai/sd-turbo",
      "temperature": 0.7,
      "max_tokens": 8192,
      "extra_params": {}
    },
    "audio_tts": {
      "role": "audio_tts",
      "model": "lemonade/kokoro-v1",
      "fallback": "openrouter/openai/tts-1",
      "temperature": 0.7,
      "max_tokens": 8192,
      "extra_params": {}
    },
    "audio_stt": {
      "role": "audio_stt",
      "model": "lemonade/Whisper-Tiny",
      "fallback": "openrouter/openai/whisper-1",
      "temperature": 0.7,
      "max_tokens": 8192,
      "extra_params": {}
    }
  },
  "default_role": "chat"
}