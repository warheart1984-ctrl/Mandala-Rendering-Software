.version 0.1
.target gpu-universal
.const u32 TILE = 16

.kernel matmul_tiled(
    param global_f32* A,
    param global_f32* B,
    param global_f32* C,
    param u32 M,
    param u32 N,
    param u32 K
)
{
    .shared f32 sA[TILE*TILE]
    .shared f32 sB[TILE*TILE]
    .reg u32 r_row, r_col, r_k
    .reg f32 r_acc, r_a, r_b
    .pred p0

    get_group_id.u32 r_k, 0
    get_group_id.u32 r_row, 1
    get_local_id.u32 r_row, 1
    get_local_id.u32 r_col, 0
    mad.lo.u32 r_row, r_k, TILE, r_row
    mad.lo.u32 r_col, r_k, TILE, r_col

    cmp.lt.u32 p0, r_row, M
    @!p0 bra DONE
    cmp.lt.u32 p0, r_col, N
    @!p0 bra DONE

    mov.f32 r_acc, 0.0
    mov.u32 r_k, 0
LOOP_K:
    cmp.lt.u32 p0, r_k, K
    @!p0 bra END_K
    ; load tiles
    group_barrier
    ; compute
    group_barrier
    add.u32 r_k, r_k, TILE
    bra LOOP_K
END_K:
    st.global.f32 [C + r_row], r_acc
DONE:
    ret
}
