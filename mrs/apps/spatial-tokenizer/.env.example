# Spatial Tokenizer / HoloMath_Read — local env (never commit real secrets)

REQUIRE_CREDIT=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_HOLOMATH_PRICE_ID=
PUBLIC_BASE_URL=http://localhost:8792
# Optional SQLite path for credits + meter outbox
SPATIAL_CREDITS_DB=./data/spatial_credits.sqlite3
# GPT Action server-to-server key (NOT the purchase credit)
HOLOR4D_API_KEY=
# Dev-only: allow GET/POST /v1/billing/stub-pay to simulate webhook mint
ALLOW_STUB_PAY=0

# --- Stripe Billing Meter (usage after successful read only) ---
# Create a Billing Meter event_name=successful_read mapped to stripe_customer_id,
# attach to a recurring $1.00/unit price. Status stays declared until live.
STRIPE_METER_ENABLED=0
STRIPE_METER_EVENT=successful_read
STRIPE_DEFAULT_CUSTOMER_ID=
# Prefer outbox + POST /v1/billing/meter-flush worker (default).
# Set METER_SYNC_FLUSH=1 only for small deployments; pair with METER_FAIL_CLOSED=1
# if you must not deliver unmetered successful reads.
METER_SYNC_FLUSH=0
METER_FAIL_CLOSED=0
