# Seedance 2.0 (cloud) — operator env (additive)

Copy keys into your real `.env` (repo root or `mrs/apps/genblaze-media/.env`).
This file is **not** loaded automatically; it avoids editing conflicted `.env.example`.

# Still required to expose /api/generate-video
GENBLAZE_VIDEO_ENABLED=0

# nvidia (default Cosmos NIM) | seedance (ByteDance via fal.ai)
GENBLAZE_VIDEO_BACKEND=nvidia

# fal.ai key — https://fal.ai/dashboard/keys
# Alias accepted: SEEDANCE_API_KEY
FAL_KEY=

# Model endpoint id on fal (text-to-video)
SEEDANCE_MODEL=bytedance/seedance-2.0/text-to-video

# Gateway-dependent. fal T2V schema commonly documents 480p|720p;
# 1080p may work on some accounts/gateways — verify before claiming.
SEEDANCE_RESOLUTION=720p
SEEDANCE_DURATION=5
SEEDANCE_ASPECT_RATIO=16:9
SEEDANCE_GENERATE_AUDIO=1

# Prefer false for commercial fal; consumer free UIs may force watermarks.
SEEDANCE_WATERMARK=0

# Optional overrides
# SEEDANCE_FAL_RUN_BASE=https://fal.run
# SEEDANCE_FAL_QUEUE_BASE=https://queue.fal.run
# SEEDANCE_HTTP_TIMEOUT=900
# SEEDANCE_POLL_TIMEOUT=900

# Offline stub (no paid fal call)
# GENBLAZE_DRY_RUN=1
