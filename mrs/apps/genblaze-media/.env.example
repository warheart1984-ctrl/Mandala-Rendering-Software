# Copy values from repo-root `.env` or set here for local overrides.
# Never commit real secrets.

NVIDIA_API_KEY=
# Optional aliases (app dual-exports from NVIDIA_API_KEY when set):
# NGC_API_KEY=
# NVIDIA_NIM_API_KEY=
B2_KEY_ID=
# MRS uses B2_APPLICATION_KEY; Genblaze-s3 reads B2_APP_KEY — set either (app dual-exports).
B2_APPLICATION_KEY=
# B2_APP_KEY=
B2_BUCKET=Mandala-Rendering-System
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
GENBLAZE_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# Cosmos text-to-video (CMM-NIM-Cosmos). Optional 12b fallback when available:
# GENBLAZE_VIDEO_MODEL=nvidia/cosmos-1.0-12b-diffusion-text2world
GENBLAZE_VIDEO_MODEL=nvidia/cosmos-1.0-7b-diffusion-text2world
# GENBLAZE_VIDEO_ENABLED=1  # default on — set 0 to disable /api/generate-video
GENBLAZE_STORAGE_PREFIX=genblaze-media
# FLUX cold-start: long read + NVCF long-poll window (then 202→poll)
# GENBLAZE_HTTP_TIMEOUT=600
# GENBLAZE_NVCF_TIMEOUT=600
# GENBLAZE_PIPELINE_TIMEOUT=720
# GENBLAZE_NVCF_POLL_SECONDS=90
# Cosmos video is colder/longer — optional overrides (defaults already higher for video path):
# GENBLAZE_VIDEO_HTTP_TIMEOUT=900
# GENBLAZE_VIDEO_NVCF_TIMEOUT=900
# GENBLAZE_VIDEO_PIPELINE_TIMEOUT=1200
# GENBLAZE_VIDEO_NVCF_POLL_SECONDS=120
# GENBLAZE_DRY_RUN=1   # unit tests / offline only — not for live Devpost demos
# B2_PROBE_ON_HEALTH=0  # default off — /health ListObjects burns Class C; set 1 only to debug B2 creds
# B2_PROBE_ON_HEALTH=1
# GENBLAZE_ABSTRACT_RETRY=1  # default on — after near-black people blank, one abstract mandala/tesseract rewrite
# GENBLAZE_ABSTRACT_RETRY=0  # disable to save a second FLUX + B2 write (free-tier Class C)
