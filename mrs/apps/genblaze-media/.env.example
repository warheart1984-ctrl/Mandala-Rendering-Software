# Copy values from repo-root `.env` or set here for local overrides.
# Never commit real secrets.

NVIDIA_API_KEY=
# Optional aliases (app dual-exports from NVIDIA_API_KEY when set):
# NGC_API_KEY=
# NVIDIA_NIM_API_KEY=
B2_KEY_ID=
# MRS uses B2_APPLICATION_KEY; Genblaze-s3 reads B2_APP_KEY — set either (app dual-exports).
B2_APPLICATION_KEY=
# B2_APP_KEY=
B2_BUCKET=Mandala-Rendering-System
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
GENBLAZE_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# Video (CMM-NIM-Cosmos): unset GENBLAZE_VIDEO_ENABLED defaults OFF (stills-only
# demo default), even when NVIDIA_API_KEY is present. API stays intact.
# GENBLAZE_VIDEO_ENABLED=0  # explicit off (same as unset)
# GENBLAZE_VIDEO_ENABLED=1  # re-enable Cosmos video UI + API
# nvidia (Cosmos NIM, default) | seedance (ByteDance via fal.ai)
GENBLAZE_VIDEO_BACKEND=nvidia
# Cosmos model (catalog access is key-dependent). Default 1.0-7b; optional 12b
# when available on the key. Cosmos 2.0 slug only if confirmed in the catalog:
# GENBLAZE_VIDEO_MODEL=nvidia/cosmos-2.0-diffusion-text2world
# GENBLAZE_VIDEO_MODEL=nvidia/cosmos-1.0-12b-diffusion-text2world
GENBLAZE_VIDEO_MODEL=nvidia/cosmos-1.0-7b-diffusion-text2world
# Seedance via fal.ai (paid API; consumer Dreamina/Jimeng/CapCut free credits are separate):
FAL_KEY=
SEEDANCE_MODEL=bytedance/seedance-2.0/text-to-video
SEEDANCE_RESOLUTION=720p
SEEDANCE_DURATION=5
SEEDANCE_ASPECT_RATIO=16:9
SEEDANCE_GENERATE_AUDIO=1
# Watermark outcome is gateway/account-dependent — not guaranteed by this app:
SEEDANCE_WATERMARK=0
# See also env.seedance.example for Seedance-only knobs (not auto-loaded).
GENBLAZE_STORAGE_PREFIX=genblaze-media
# FLUX cold-start: long read + NVCF long-poll window (then 202→poll)
# Defaults: HTTP/NVCF 600s, pipeline 720s, poll 180s (NVIDIA max poll 300).
# Render blueprint uses poll=300. There is no prefer_async flag; NVIDIA
# returning 202 + NVCF-REQID activates polling automatically.
# GENBLAZE_HTTP_TIMEOUT=600
# GENBLAZE_NVCF_TIMEOUT=600
# GENBLAZE_PIPELINE_TIMEOUT=720
# GENBLAZE_NVCF_POLL_SECONDS=180
# Empty gateway 504 ({\"_raw\": \"\"}): default is operator-visible manual retry.
# GENBLAZE_EMPTY_504_RETRY=0
# GENBLAZE_EMPTY_504_RETRY=1   # one delayed server retry only after empty 504 (may double-bill)
# GENBLAZE_EMPTY_504_RETRY_DELAY=45
# GENBLAZE_NVIDIA_WARMUP_ON_STARTUP=0
# GENBLAZE_NVIDIA_WARMUP_ON_STARTUP=1  # probe can itself 504 when NIM is unavailable
# Cosmos video is colder/longer — optional overrides (defaults already higher for video path):
# GENBLAZE_VIDEO_HTTP_TIMEOUT=900
# GENBLAZE_VIDEO_NVCF_TIMEOUT=900
# GENBLAZE_VIDEO_PIPELINE_TIMEOUT=1200
# GENBLAZE_VIDEO_NVCF_POLL_SECONDS=120
# GENBLAZE_DRY_RUN=1   # unit tests / offline only — not for live Devpost demos
# B2_PROBE_ON_HEALTH=0  # default off — /health ListObjects burns Class C; set 1 only to debug B2 creds
# B2_PROBE_ON_HEALTH=1
# GENBLAZE_ABSTRACT_RETRY=1  # default on — after near-black people blank, one abstract mandala/tesseract rewrite
# GENBLAZE_ABSTRACT_RETRY=0  # disable to save a second FLUX + B2 write (free-tier Class C)
# Keep RT4D as the base still renderer; NVIDIA is an optional second step:
# GENBLAZE_IMAGE_BACKEND=rt4d
# NVIDIA_API_KEY=…   # required for POST /api/rt4d-to-nvidia (NIM vision → SceneSpec)
# GENBLAZE_IMAGE_TO_SCENE_MODEL=meta/llama-3.2-11b-vision-instruct
# GENBLAZE_IMAGE_TO_SCENE_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
# --- Image polish (img2img diffusion cleanup of RT4D stills) ---
# Structure-first, then AI clean-up: /api/polish-still applies diffusion img2img
# to a prior RT4D/generate still. Structure pass = MRS RT4D; polish = diffusion edit.
# For abstract/lattice scenes, recommend strength 0.35-0.55 so geometry stays readable.
# GENBLAZE_POLISH_ENABLED=1
# GENBLAZE_POLISH_BACKEND=auto       # auto | fal | nvidia (auto: try NVIDIA, then fal)
# GENBLAZE_POLISH_MODEL=fal-ai/flux/dev/image-to-image
# GENBLAZE_POLISH_DEFAULT_STRENGTH=0.45
# Img2img provider key (fal.ai FLUX image-to-image). Also used by Seedance video:
# FAL_KEY=
# NVIDIA img2img is not guaranteed (NIM FLUX endpoint may be T2I-only). When
# img2img_wired:true appears in /health.rt4d_to_nvidia it reflects the polish
# path, not the NIM vision path. Set GENBLAZE_POLISH_BACKEND=nvidia to require
# NVIDIA (no fal fallback).
# --- Engine3D structure still (soft-raster beauty + AOVs) ---
# ENGINE3D_STILL_ENABLED=1
# ENGINE3D_STILL_SCRIPT_PATH=   # default: mrs/packages/engine3d-core/scripts/render-engine3d-still.mjs
# ENGINE3D_STILL_TIMEOUT=120
# Build first: cd mrs/packages/engine3d-core && npm run build
# Then: POST /api/engine3d-still (optional rt4d_background_run_id + polish)
# --- Engine3D short cinematic sequence (soft-raster orbit) ---
# ENGINE3D_SEQUENCE_ENABLED=1
# ENGINE3D_SEQUENCE_SCRIPT_PATH=  # default: …/render-engine3d-sequence.mjs
# ENGINE3D_SEQUENCE_TIMEOUT=180
# ENGINE3D_SEQUENCE_MAX_FRAMES=24
# Then: POST /api/engine3d-sequence { width, height, duration, fps }
# --- ChatGPT / Custom GPT Actions (Engine3D plugin surface) ---
# Classic ChatGPT Plugins storefront is sunset; use Custom GPT → Actions →
# import https://<host>/plugin/openapi.json (or paste OpenAPI).
# CHATGPT_PLUGIN_KEY=          # optional bearer; when set, gates /api/engine3d-*
# GENBLAZE_PUBLIC_BASE_URL=https://<your-ngrok>.ngrok-free.app
# GENBLAZE_CORS_ALLOW_ALL=1    # explicit only; plugin key does NOT auto-enable CORS
# GENBLAZE_CORS_ORIGINS=https://chatgpt.com,https://chat.openai.com
#   # optional tighter allowlist; use * only for short-lived ngrok demos (any site can POST spendy routes)
# Discover: GET /.well-known/ai-plugin.json  and  GET /plugin/openapi.json
