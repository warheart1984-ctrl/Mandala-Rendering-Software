{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mrs://sovereign-sculptor/schemas/sculpt-document.schema.json",
  "title": "Sovereign Sculptor Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","status","id","species","topologyState","topologyRevision","identity","morphologyProfile","vertices","triangles","regions","masks","operationLog"],
  "properties": {
    "schemaVersion":{"const":"sovereign-sculpt/1.0"},
    "status":{"const":"core-enforced-fixture-not-production-sculpt"},
    "id":{"$ref":"#/$defs/id"}, "species":{"enum":["human","fox","anthro"]},
    "topologyState":{"enum":["authoring","locked"]}, "topologyRevision":{"type":"integer","minimum":0},
    "parentTopologyDigest":{"$ref":"#/$defs/sha256"},
    "identity":{"$ref":"#/$defs/identity"}, "morphologyProfile":{"$ref":"#/$defs/morphology"},
    "vertices":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/vertex"}},
    "triangles":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/triangle"}},
    "regions":{"type":"array","items":{"$ref":"#/$defs/region"}},
    "masks":{"type":"array","items":{"$ref":"#/$defs/mask"}},
    "operationLog":{"type":"array","items":{"$ref":"#/$defs/operationRecord"}}
  },
  "$defs": {
    "id":{"type":"string","minLength":1,"maxLength":256}, "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "vec3":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"minItems":3,"maxItems":3},
    "gender":{"type":"object","additionalProperties":false,"required":["identity","attribution"],"properties":{"identity":{"$ref":"#/$defs/id"},"pronouns":{"type":"array","items":{"type":"string","minLength":1}},"attribution":{"enum":["self-described","creator-authored"]}}},
    "identity":{"type":"object","additionalProperties":false,"required":["id","displayName","gender"],"properties":{"id":{"$ref":"#/$defs/id"},"displayName":{"$ref":"#/$defs/id"},"gender":{"$ref":"#/$defs/gender"}}},
    "morphology":{"type":"object","additionalProperties":false,"required":["stature","bodyMass","limbLength","torsoLength","headScale","muzzleLength","earScale","tailLength","digitigradeBias"],"properties":{"stature":{"type":"number","minimum":0,"maximum":1},"bodyMass":{"type":"number","minimum":0,"maximum":1},"limbLength":{"type":"number","minimum":0,"maximum":1},"torsoLength":{"type":"number","minimum":0,"maximum":1},"headScale":{"type":"number","minimum":0,"maximum":1},"muzzleLength":{"type":"number","minimum":0,"maximum":1},"earScale":{"type":"number","minimum":0,"maximum":1},"tailLength":{"type":"number","minimum":0,"maximum":1},"digitigradeBias":{"type":"number","minimum":0,"maximum":1}}},
    "vertex":{"type":"object","additionalProperties":false,"required":["id","position"],"properties":{"id":{"$ref":"#/$defs/id"},"position":{"$ref":"#/$defs/vec3"}}},
    "triangle":{"type":"object","additionalProperties":false,"required":["id","vertexIndices","regionId"],"properties":{"id":{"$ref":"#/$defs/id"},"vertexIndices":{"type":"array","prefixItems":[{"type":"integer","minimum":0},{"type":"integer","minimum":0},{"type":"integer","minimum":0}],"minItems":3,"maxItems":3},"regionId":{"$ref":"#/$defs/id"}}},
    "region":{"type":"object","additionalProperties":false,"required":["id","vertexIndices"],"properties":{"id":{"$ref":"#/$defs/id"},"vertexIndices":{"type":"array","items":{"type":"integer","minimum":0}}}},
    "mask":{"type":"object","additionalProperties":false,"required":["id","weights"],"properties":{"id":{"$ref":"#/$defs/id"},"weights":{"type":"array","items":{"type":"number","minimum":0,"maximum":1}}}},
    "operationRecord":{"type":"object","additionalProperties":false,"required":["id","kind","operationHash"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["move","scale","rotate","mask","subdivide","lock-topology"]},"operationHash":{"$ref":"#/$defs/sha256"}}}
  }
}
