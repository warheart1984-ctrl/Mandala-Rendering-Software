{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrs.local/cros/schemas/render_execution.schema.json",
  "title": "CROS RenderExecution",
  "description": "Stage 4 of 7. The observed run of a RenderPlan. Subject to CI-003 — an execution with no progress observations is not observable and is therefore invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["crosVersion", "kind", "id", "createdAt", "profile", "derivedFrom", "planHash", "adapter", "state", "startedAt", "progressEvents", "contentHash"],
  "properties": {
    "crosVersion": { "const": "0.1.0" },
    "kind": { "const": "RenderExecution" },
    "id": { "$ref": "#/$defs/ArtifactId" },
    "createdAt": { "type": "string", "format": "date-time" },
    "profile": { "$ref": "#/$defs/ProfileId" },
    "derivedFrom": { "$ref": "#/$defs/ArtifactId", "description": "id of the RenderPlan." },
    "planHash": { "$ref": "#/$defs/Sha256", "description": "contentHash of that RenderPlan." },
    "adapter": { "$ref": "#/$defs/AdapterRef" },
    "state": { "enum": ["pending", "running", "succeeded", "failed", "cancelled"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "progressEvents": {
      "type": "array",
      "minItems": 1,
      "description": "CI-003. minItems 1 at the schema level; monotonic non-decreasing fraction is checked by cros.validation.check_ci003_execution_observable (not expressible in JSON Schema).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "phase", "fraction"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "phase": { "type": "string", "minLength": 1 },
          "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
          "message": { "type": "string" }
        }
      }
    },
    "providerRequestId": {
      "type": "string",
      "description": "Generative profiles: the provider-side request identifier. Required by cros.gen-ai-nim replay evidence."
    },
    "contentHash": { "$ref": "#/$defs/Sha256" }
  },
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ArtifactId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "ProfileId": { "enum": ["cros.dcc-offline", "cros.gen-ai-nim"] },
    "AdapterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
