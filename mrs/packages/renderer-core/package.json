{
  "name": "@mrs/renderer-core",
  "version": "1.0.0",
  "description": "4DRS surface renderer + RT4D path engine (MRS renderer core)",
  "type": "module",
  "main": "src/index.js",
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./src/index.js"
    },
    "./surfaces": "./src/surfaces/index.js",
    "./math": "./src/math/index.js",
    "./math3d": "./src/math3d/index.js",
    "./math3d/*": "./src/math3d/*",
    "./bridge": "./src/bridge/index.js",
    "./bridge/*": "./src/bridge/*",
    "./engine3d": "./src/engine3d/index.js",
    "./engine3d/*": "./src/engine3d/*",
    "./render/canvas": "./src/render/canvas-renderer.js",
    "./inspector": "./src/inspector/index.js",
    "./live-link": "./src/live-link/index.js",
    "./plp": "./src/plp/index.js",
    "./scene-spec": "./src/scene-spec/index.js",
    "./rt4d": "./src/render/rt4d/index.js",
    "./rt4d/math": "./src/render/rt4d/math/index.js",
    "./rt4d/invariants": "./src/render/rt4d/invariants/index.js",
    "./rt4d/geometry": "./src/render/rt4d/geometry/index.js",
    "./rt4d/material": "./src/render/rt4d/material/index.js",
    "./rt4d/integrator": "./src/render/rt4d/integrator/index.js",
    "./rt4d/accel": "./src/render/rt4d/accel/index.js",
    "./rt4d/output": "./src/render/rt4d/output/index.js",
    "./rt4d/scene": "./src/render/rt4d/scene/index.js",
    "./math/*": "./src/math/*",
    "./surfaces/*": "./src/surfaces/*",
    "./render/*": "./src/render/*",
    "./pipeline/*": "./src/pipeline/*",
    "./pipeline/ExportManager": "./src/pipeline/ExportManager.js"
  },
  "bin": {
    "4d-render": "src/cli.js"
  },
  "scripts": {
    "render": "node src/cli.js render",
    "list": "node src/cli.js list",
    "test": "node src/cli.js render --surface tesseract --single --width 320 --height 240 --output output/test",
    "test:frames": "node src/cli.js render --surface clifford-torus --frames 8 --fps 8 --width 320 --height 240 --mode wireframe --resolution 16 --output output/test",
    "test:wavefront": "node --test src/render/rt4d/gpu/wavefront/wavefront.phaseb.test.js",
    "test:phasec": "node --test src/render/rt4d/physics/phasec.scaffold.test.js",
    "test:render-still": "node --test scripts/test/render-still.test.js",
    "test:math3d": "node --test src/math3d/math3d.test.js",
    "test:bridge": "node --test src/bridge/bridge.test.js",
    "test:engine3d": "node --test src/engine3d/engine3d.test.js",
    "test:scene-spec": "node --test src/scene-spec/scene-spec.test.js",
    "test:render-scene": "node --test scripts/test/render-scene.test.js",
    "demo:engine3d": "node scripts/engine3d-demo.mjs",
    "render-still": "node scripts/render-still.mjs",
    "render-scene": "node scripts/render-scene.mjs"
  },
  "dependencies": {
    "canvas": "^3.1.0",
    "commander": "^13.1.0",
    "ws": "^8.21.1"
  }
}
