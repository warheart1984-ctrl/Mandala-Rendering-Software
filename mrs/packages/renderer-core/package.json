{
  "name": "@mrs/renderer-core",
  "version": "1.5.0",
  "description": "4DRS surface renderer + RT4D path engine (MRS renderer core)",
  "type": "module",
  "main": "src/index.js",
  "types": "types.d.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.wgsl",
    "src/**/*.json",
    "schemas/**",
    "types.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./types.d.ts",
      "default": "./src/node.js"
    },
    "./surfaces": "./src/surfaces/index.js",
    "./math": "./src/math/index.js",
    "./math3d": "./src/math3d/index.js",
    "./math3d/*": "./src/math3d/*",
    "./bridge": "./src/bridge/index.js",
    "./bridge/*": "./src/bridge/*",
    "./engine3d": "./src/engine3d/index.js",
    "./engine3d/*": "./src/engine3d/*",
    "./render/canvas": "./src/render/canvas-renderer.js",
    "./inspector": "./src/inspector/index.js",
    "./live-link": "./src/live-link/index.js",
    "./plp": "./src/plp/index.js",
    "./interop": "./src/interop/index.js",
    "./scene-spec": "./src/scene-spec/index.js",
    "./rt4d": "./src/render/rt4d/index.js",
    "./rt4d/math": "./src/render/rt4d/math/index.js",
    "./rt4d/invariants": "./src/render/rt4d/invariants/index.js",
    "./rt4d/geometry": "./src/render/rt4d/geometry/index.js",
    "./rt4d/material": "./src/render/rt4d/material/index.js",
    "./rt4d/integrator": "./src/render/rt4d/integrator/index.js",
    "./rt4d/accel": "./src/render/rt4d/accel/index.js",
    "./rt4d/output": "./src/render/rt4d/output/index.js",
    "./rt4d/projection": "./src/render/rt4d/projection/index.js",
    "./rt4d/scene": "./src/render/rt4d/scene/index.js",
    "./math/*": "./src/math/*",
    "./surfaces/*": "./src/surfaces/*",
    "./render/*": "./src/render/*",
    "./pipeline/*": "./src/pipeline/*",
    "./pipeline/ExportManager": "./src/pipeline/ExportManager.js"
  },
  "bin": {
    "4d-render": "src/cli.js"
  },
  "scripts": {
    "render": "node src/cli.js render",
    "list": "node src/cli.js list",
    "test": "node src/cli.js render --surface tesseract --single --width 320 --height 240 --output output/test",
    "test:frames": "node src/cli.js render --surface clifford-torus --frames 8 --fps 8 --width 320 --height 240 --mode wireframe --resolution 16 --output output/test",
    "test:wavefront": "node --test src/render/rt4d/gpu/wavefront/wavefront.phaseb.test.js",
    "test:phasec": "node --test src/render/rt4d/physics/phasec.scaffold.test.js",
    "test:render-still": "node --test scripts/test/render-still.test.js",
    "test:engine3d-bridge": "node --test src/render/rt4d/bridge/engine3dBridgeScene.test.js",
    "test:math3d": "node --test src/math3d/math3d.test.js",
    "test:bridge": "node --test src/bridge/bridge.test.js",
    "test:engine3d": "node --test src/engine3d/engine3d.test.js",
    "test:scene-spec": "node --test src/scene-spec/scene-spec.test.js",
    "test:interop": "node --test src/interop/fourd-shading-types.test.js",
    "test:shading-wire": "node --test src/live-link/shadingWire.test.js src/live-link/publishToggleLifecycle.test.js",
    "test:projection": "node --test src/render/rt4d/test/projection.continuity.test.js src/render/rt4d/test/projection.invariants.test.js src/render/rt4d/test/projection.lens.northstar.test.js src/render/rt4d/test/projection.kernel.strength.test.js",
    "test:cinematic": "node --test src/render/rt4d/constitutional/test/cinematic.environment.test.js",
    "validate:shading-ws": "node scripts/validate-shading-ws.mjs --harness",
    "test:render-scene": "node --test scripts/test/render-scene.test.js",
    "demo:engine3d": "node scripts/engine3d-demo.mjs",
    "demo:cinematic": "node scripts/movie-4d-cinematic-sunrise.mjs --frames 300 --fps 30",
    "demo:trailer": "node scripts/movie-4d-cinematic-trailer.mjs --frames 300 --fps 30 --world world-cinematic-trailer-001 --no-encode",
    "demo:trailer-full": "node scripts/generate-trailer-audio.mjs && node scripts/movie-4d-cinematic-trailer.mjs --frames 300 --fps 30 --world world-cinematic-trailer-001",
    "tts:trailer": "node scripts/generate-trailer-audio.mjs",
    "demo:salt-map": "node scripts/movie-salt-map-anime.mjs --frames 450 --fps 30 --world world-salt-map-anime-001 --no-encode",
    "demo:salt-map-full": "node scripts/movie-salt-map-anime.mjs --frames 450 --fps 30 --world world-salt-map-anime-001",
    "render:salt-map": "node scripts/render-salt-map.mjs --frames 450 --fps 30 --world world-salt-map-anime-001",
    "render:salt-map-full": "node scripts/render-salt-map.mjs --frames 450 --fps 30 --world world-salt-map-anime-001 --encode",
    "render-still": "node scripts/render-still.mjs",
    "render-scene": "node scripts/render-scene.mjs",
    "test:photoreal:material": "node --test src/render/photoreal/material/test/*.test.js",
    "test:photoreal:lighting": "node --test src/render/photoreal/lighting/test/*.test.js",
    "test:photoreal:camera": "node --test src/render/photoreal/camera/test/*.test.js",
    "test:photoreal:integrator": "node --test src/render/photoreal/integrator/test/*.test.js",
    "test:photoreal:denoiser": "node --test src/render/photoreal/denoiser/test/*.test.js",
    "test:photoreal:compositor": "node --test src/render/photoreal/compositor/test/*.test.js",
    "test:photoreal:evidence": "node --test src/render/photoreal/evidence/test/*.test.js",
    "test:photoreal:env": "node --test src/render/photoreal/test/*.test.js",
    "test:photoreal": "npm run test:photoreal:material && npm run test:photoreal:lighting && npm run test:photoreal:camera && npm run test:photoreal:integrator && npm run test:photoreal:denoiser && npm run test:photoreal:compositor && npm run test:photoreal:evidence && npm run test:photoreal:env",
    "demo:photoreal": "node scripts/render-photoreal-golden-hour.mjs --frames 10 --fps 30 --width 320 --height 180 --spp 1 --max-depth 2 --world world-photoreal-golden-hour-001 --no-encode",
    "demo:photoreal-full": "node scripts/render-photoreal-golden-hour.mjs --frames 300 --fps 30 --world world-photoreal-golden-hour-001"
  },
  "dependencies": {
    "canvas": "^3.1.0",
    "commander": "^13.1.0",
    "ws": "^8.21.1"
  }
}
