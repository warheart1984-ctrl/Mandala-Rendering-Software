{

  "schemaVersion": "2.0",

  "kind": "PrintSurfaceContract",

  "id": "mrs-digital-print-surface-contract",

  "status": "enforced",

  "version": "2.0",

  "governingInvariant": "Rendering = deterministic printing of declared surfaces. No hallucination.",

  "owner": "mrs/adapters/storyforge-boundary",

  "sfBoundary": {

    "storyPromptSpec": "declared-sf-owned-not-in-mrs",

    "renderRequestIntake": "enforced"

  },

  "requiredSurfaces": {

    "scene-spec": {

      "intake": ["RenderRequest", "payload.sceneSpecification", "payload.render"],

      "aovs": ["beauty"],

      "optionalAovs": ["depth", "normal"],

      "printStages": [

        "sampling",

        "reconstruction",

        "tonemap",

        "color",

        "encode",

        "hash_provenance"

      ]

    },

    "proton-raster": {

      "intake": ["RenderRequest", "payload.render"],

      "aovs": ["beauty"],

      "optionalAovs": ["depth", "normal"]

    },

    "engine3d-world": {

      "intake": ["RenderRequest", "payload.engine3dWorldDocument", "payload.render"],

      "aovs": ["beauty"],

      "optionalAovs": ["depth", "normal"]

    }

  },

  "errorStates": [

    "OK",

    "SURFACE_MISSING",

    "SURFACE_INVALID",

    "AOV_MISMATCH",

    "SCENESPEC_GAP",

    "ENGINE3D_BOUNDARY_FAIL",

    "GENBLAZE_SMOKE_FAIL"

  ],

  "printRequestDefaults": {

    "width": 512,

    "height": 512,

    "samples": 24,

    "variance_threshold": 0.0008,

    "color_space": "srgb",

    "tone_mapper": "aces-lite",

    "denoise": true,

    "softPenumbra": true,

    "penumbraLightSamples": 4,

    "seed": 42,

    "format": "png",

    "quality": "print_hq"

  },

  "qualityProfiles": {

    "print_fast": { "statusTag": "enforced" },

    "print_hq": { "statusTag": "enforced" },

    "print_cinematic": { "statusTag": "enforced" },

    "print_reference": { "statusTag": "enforced" }

  },

  "timeoutGovernance": {

    "env": "MRS_PRINT_TIMEOUT_SECONDS",

    "fallbackEnv": "MRS_RENDER_TIMEOUT_SECONDS",

    "defaultSeconds": 900,

    "statusTag": "enforced"

  },

  "qualityTags": {

    "adaptiveSampling": "enforced-when-opt-in",

    "stratifiedAA": "enforced",

    "tonemapAces": "enforced-when-opt-in",

    "denoise": "enforced-when-profile-or-opt-in",

    "denoiseAllPrintBackends": "enforced",

    "softPenumbra": "enforced",

    "rt4dSpecularGgx": "enforced",

    "meshShaSyncUnityUnreal": "enforced",

    "csrEmission": "enforced",

    "governanceDecisionEmission": "enforced",

    "provenanceFrameEmission": "enforced",

    "draftCi": "fast-defaults-unchanged"

  },

  "trail": "docs/governance/cecp/trails/digital-printer-v2-2026-07/",

  "priorTrail": "docs/governance/cecp/trails/printer-mode-renderer-2026-07/"

}


