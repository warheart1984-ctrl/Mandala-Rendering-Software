{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrs.local/adapters/proton-raster-bridge/schemas/proton-raster-evidence.schema.json",
  "title": "ProtonRasterEvidence",
  "description": "Evidence / provenance shape for proton soft-splat frames. Status: declared — Implementor attaches on success.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "ok": { "type": "boolean" },
    "status": {
      "type": "string",
      "description": "skeleton | partial | enforced"
    },
    "intentId": { "type": ["string", "null"] },
    "worldId": { "type": ["string", "null"] },
    "timelineId": { "type": ["string", "null"] },
    "timeSeconds": { "type": ["number", "null"] },
    "parameters": { "type": "object" },
    "cir": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actor": { "type": "string" },
        "timestamp": { "type": ["string", "number"] },
        "purpose": { "type": "string" }
      }
    },
    "protonCount": { "type": "integer", "minimum": 0 },
    "width": { "type": "integer" },
    "height": { "type": "integer" },
    "pngPath": { "type": "string" },
    "registryHash": {
      "type": "string",
      "description": "Deterministic ProtonRegistry.hash (Implementor)"
    }
  }
}
