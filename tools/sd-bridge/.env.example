# Copy to .env in this directory and fill in. The bridge loads .env automatically.
# This file is git-ignored (never commit real keys).
# NOTE: .env values override the process environment (dotenv semantics).

# Cloud backend: cloudflare | nvidiabuild | fireworks | openai | (empty = local RX 580 only)
CLOUD_BACKEND=

# --- Cloudflare Workers AI (FREE daily quota; FLUX.1-schnell) ---
# Account ID: dash.cloudflare.com -> Workers AI page URL path segment.
# API token:  dash.cloudflare.com -> My Profile -> API Tokens -> "Workers AI - Run" template.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- build.nvidia.com (hosted NIM / FLUX) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-schnell

# --- Fireworks (flux-1-schnell-fp8; response is raw bytes) ---
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1/workflows/accounts/fireworks/models/flux-1-schnell-fp8/text_to_image

# --- OpenAI-compatible (Together, Gemini, OpenAI, ...) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.together.xyz/v1/images/generations
CLOUD_MODEL=black-forest-labs/FLUX.1-schnell

# Shared cloud options
CLOUD_STEPS=4
OUTPUT_DIR=outputs
