    "animation": { "type": "actor-driven" }
  },

  "shot": {
    "keyframes": [
      { "time": 0, "position": [0, 3, 6], "target": [0, 2, 0], "fov": 55 },
      { "time": 5, "position": [1, 3.5, 5.5], "target": [0, 2.2, 0], "fov": 50 },
      { "time": 10, "position": [0, 3, 6], "target": [0, 2, 0], "fov": 55 }
    ]
  }
}
