[
  {
    "id": "policy-no-execution-without-intent",
    "scope": "runtime",
    "condition": "intent != null",
    "rule": "deny_if_false",
    "severity": "critical",
    "message": "No execution without intent."
  },
  {
    "id": "policy-no-state-change-without-evidence",
    "scope": "state",
    "condition": "require_evidence_for_mutation",
    "rule": "deny_if_false",
    "severity": "high",
    "message": "No state change without evidence."
  },
  {
    "id": "policy-no-render-without-provenance",
    "scope": "render",
    "condition": "play_timeline_or_render_4d",
    "rule": "attach_provenance",
    "severity": "high",
    "message": "No render without provenance."
  },
  {
    "id": "policy-no-authority-without-contract",
    "scope": "authority",
    "condition": "actor_has_contract",
    "rule": "deny_if_false",
    "severity": "critical",
    "message": "No authority without contract (actor must have a registered contract)."
  },
  {
    "id": "policy-play-timeline-requires-world",
    "scope": "timeline",
    "condition": "play_timeline_requires_world",
    "rule": "deny_if_missing_world",
    "severity": "critical",
    "message": "play_timeline requires a world id on the intent."
  },
  {
    "id": "policy-ascension-drift-throttle",
    "scope": "render",
    "condition": "intent.timeline == 'mythar_ascension' && drift_score > 0.7",
    "rule": "modify_param",
    "param": "speed",
    "modifier": "speed * 0.5",
    "severity": "medium",
    "message": "Throttle ascension speed when drift is high."
  },
  {
    "id": "policy-ascension-evidence",
    "scope": "runtime",
    "condition": "intent.timeline == 'mythar_ascension'",
    "rule": "deny_if_false",
    "require": ["ev-ascension-001", "ev-ascension-002"],
    "severity": "critical",
    "message": "Mythar Ascension requires dual evidence."
  },
  {
    "id": "policy-biometric-conformance",
    "scope": "render",
    "condition": "biometric_amendment_vii",
    "rule": "deny_if_biometric_nonconformance",
    "severity": "critical",
    "haltCode": "HALT:BIOMETRIC-NONCONFORMANCE",
    "amendment": "ckl-amendment-vii-biometric-organic",
    "alias": "biometric",
    "order": 1,
    "message": "scaleClass fixtures must validate limbRatio/curvature/massDistribution within biometric profile ranges (Amendment VII §1)."
  },
  {
    "id": "policy-adaptive-scale",
    "scope": "render",
    "condition": "biometric_amendment_vii",
    "rule": "deny_if_missing_scale_context",
    "severity": "critical",
    "haltCode": "HALT:MISSING-SCALE-CONTEXT",
    "amendment": "ckl-amendment-vii-biometric-organic",
    "alias": "adaptiveScale",
    "order": 2,
    "message": "Fixtures must declare or inherit scaleClass before render (Amendment VII §2)."
  },
  {
    "id": "policy-organic-variance",
    "scope": "render",
    "condition": "biometric_amendment_vii",
    "rule": "deny_if_organic_variance_violation",
    "severity": "critical",
    "haltCode": "HALT:ORGANIC-VARIANCE-VIOLATION",
    "amendment": "ckl-amendment-vii-biometric-organic",
    "alias": "organicVariance",
    "order": 3,
    "message": "Render-time organic variance must remain >= profile minOrganicVariance; L/R averaging that flattens lawful asymmetry is denied (Amendment VII §3)."
  },
  {
    "id": "world.biogeometric",
