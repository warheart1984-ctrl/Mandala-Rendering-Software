{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrs.local/cssv/multi-gpu/cssv-multi-gpu-schema.json",
  "title": "CSSVMultiGpuFrame",
  "type": "object",
  "additionalProperties": false,
  "required": ["frameId", "devices", "strategy", "decidedAt"],
  "properties": {
    "frameId": { "type": "string", "minLength": 1 },
    "strategy": {
      "type": "string",
      "enum": ["single", "split-frame", "tiles"]
    },
    "decidedAt": { "type": "string", "format": "date-time" },
    "totalRenderTimeMs": { "type": "number", "minimum": 0 },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "backend"],
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "backend": { "type": "string" },
          "tilesAssigned": { "type": "number", "minimum": 0 },
          "samplesAssigned": { "type": "number", "minimum": 0 },
          "renderTimeMs": { "type": "number", "minimum": 0 },
          "utilization": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
