# MRS / 4DRS — environment placeholders (no secrets)
# Copy to `.env` at the repo root (or export in your shell). `.env` is gitignored.

# --- Backblaze B2 S3-Compatible API (declared / operator-configured) ---
# Do NOT use the master application key with the S3-Compatible API.
# Create a non-master application key scoped to your bucket.
# Docs: docs/ops/BACKBLAZE_B2_S3.md

B2_KEY_ID=<REPLACE_ME>
B2_APPLICATION_KEY=<REPLACE_ME>
# Genblaze-s3 also reads B2_APP_KEY — mrs/apps/genblaze-media dual-exports both names.
# B2_APP_KEY=<REPLACE_ME>
B2_BUCKET=your-mrs-assets-bucket
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# Optional: force path-style URLs (default true in @mrs/storage-b2)
# B2_FORCE_PATH_STYLE=true

# Optional AWS SDK / CLI aliases (used if B2_KEY_ID / B2_APPLICATION_KEY unset)
# AWS_ACCESS_KEY_ID=<REPLACE_ME>
# AWS_SECRET_ACCESS_KEY=<REPLACE_ME>
# AWS_REGION=us-west-004

# --- Genblaze concept media (mrs/apps/genblaze-media) ---
# Free NIM key: https://build.nvidia.com/
# NVIDIA_API_KEY=<REPLACE_ME>
# GENBLAZE_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# NVIDIA_EMBED_MODEL=nvidia/nv-embedcode-7b-v1
# NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings
# GENBLAZE_STORAGE_PREFIX=genblaze-media
# GENBLAZE_DRY_RUN=1
# Hackathon demo cache (pre-render → B2 → live overlay):
# GENBLAZE_DEMO_CACHE=0
# GENBLAZE_DEMO_CACHE_SHOT=mandala-open
# GENBLAZE_DEMO_CACHE_FRAME=0
# GENBLAZE_PRE_RENDER_FALLBACK=0
# GENBLAZE_PRE_RENDER_SHOTS_PER_HOUR=4
# GMI Cloud (GenBlaze SDK fan-out; hackathon credits — never commit the key):
# GMI_API_KEY=<REPLACE_ME>
# GMI_BASE_URL=
# GENBLAZE_GMI_IMAGE_MODEL=seedream-5.0-lite
# Free polish fallback Space (optional override):
# GENBLAZE_HFSPACE_URL=https://m3st3rj4k3l-flux-2-klein-multi-lora.hf.space
# GENBLAZE_POLISH_BACKEND=auto
# NIM reliability (assist path — never Digital Printer beauty SoT):
# GENBLAZE_NVCF_POLL_SECONDS=180
# GENBLAZE_HTTP_TIMEOUT=600
# GENBLAZE_EMPTY_504_RETRY=0
# GENBLAZE_EMPTY_504_RETRY_DELAY=45
# GENBLAZE_NVIDIA_WARMUP_ON_STARTUP=0
# Local Lemonade diffusion (AMD local-ai-use / assist — not RT4D print):
# GENBLAZE_IMAGE_BACKEND=lemonade
# LEMONADE_BASE_URL=http://127.0.0.1:13305/api/v1
# GENBLAZE_LEMONADE_MODEL=SD-Turbo
# GENBLAZE_LEMONADE_SIZE=512x512
# GENBLAZE_LEMONADE_STEPS=4
# AMD host without sd-server: skip local SD; pre-render beauty on a GMI/cloud host:
# GENBLAZE_SKIP_LOCAL_SD=1

# --- CSSV Server Security (optional) ---
# CSSV_API_KEY=<REPLACE_ME>
# CSSV_ALLOWED_ORIGINS=http://localhost:8080
# CSSV_RATE_LIMIT=60

# --- Jarvis Memory Board (session persistence) ---
# JARVIS_MEMORYBOARD_URL=http://127.0.0.1:8001

# --- Prompt→Scene bridge / Engine3D expand (Genblaze; no secrets) ---
# Repo-root Docker pins these under /app; monorepo dual-layout resolves without them.
# PROMPT_SCENE_BRIDGE_ENABLED=1
# PROMPT_SCENE_BRIDGE_SCRIPT=/app/prompt-scene-bridge/run_bridge.py
# PROMPT_SCENE_BRIDGE_PYTHON=python
# PROMPT_SCENE_BRIDGE_TIMEOUT=90
# PROMPT_SCENE_EXPAND_WORLD=0
# ENGINE3D_EXPAND_SCRIPT=/app/engine3d-core/scripts/expand-world-document.mjs
# Optional Infinity lane on the bridge worker only (never import under Genblaze app/):
# INFINITY_STORY_SRC=
# PROMPT_SCENE_INFINITY_SRC=

# --- StoryForge Runtime crossing (MRS RenderRequest→RenderResult; no secrets) ---
# MRS_RENDER_REQUEST_EXECUTE=0
# RENDER_REQUEST_API_ENABLED=0
# RENDER_REQUEST_PIPELINE_SCRIPT=/app/storyforge-boundary/run_pipeline.py
# PROTON_PIPELINE_SCRIPT=/app/proton-raster-bridge/run_proton_pipeline.mjs
# MRS_RENDER_OUTPUT_DIR=/app/data/output
# MRS_RENDER_TIMEOUT_SECONDS=120
# SCENE_SPEC_SCRIPT_PATH=/app/renderer-core/scripts/render-scene.mjs
# RT4D_NODE_PATH=node

# --- Face Creation Assist (Sovereign X; assistOnly — not print SoT) ---
# FACE_CREATION_ASSIST_ENABLED=0
# FACE_CREATION_ASSIST_CLI_PATH=
# FACE_CREATION_ASSIST_TIMEOUT=120
