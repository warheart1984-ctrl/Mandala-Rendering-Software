{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "jarvis-emr": {
        "command": "python",
        "args": ["-m", "mcp_server"],
        "cwd": "jarvis-memoryboard",
        "env": {
          "JARVIS_MEMORYBOARD_URL": "http://127.0.0.1:8001"
        }
      }
    }
  }
}
