JARVIS_HOST=0.0.0.0
JARVIS_PORT=8001
JARVIS_STORE_PATH=data/jarvis-store.json
JARVIS_EMR_DYNAMICS_PATH=data/emr-dynamics.json
JARVIS_CORS_ORIGINS=*

# Local dev: leave unset for open recall. Render/public: required.
# EMR_RECALL_API_KEY=

# Public deploy: disable ledger writes (recall-only).
# JARVIS_MEMORY_WRITE_ENABLED=false

# When EMR_RECALL_API_KEY is set, require it for GET /api/jarvis/memory/* too.
# JARVIS_PROTECT_LEDGER_READ=true

# Remote MCP client pointing at Render:
# JARVIS_MEMORYBOARD_URL=https://your-service.onrender.com
# EMR_RECALL_API_KEY=...
