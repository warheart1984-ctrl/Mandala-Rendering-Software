// Status: partial — algorithm sketch for palette LUT + sat/contrast/gamma.
// Not wired into RDG yet (see AnimeColorGradePass.cpp). Zero diffusion.

#include "/Engine/Public/Platform.ush"

#define THREADS_X 8
#define THREADS_Y 8

// Sampler must be bound by the pass parameter struct when RDG lands.
SamplerState AnimeLinearClampSampler;

RWTexture2D<float4> OutputTexture;

Texture2D<float4> SceneColorTexture;
Texture2D<float4> PaletteLUTTexture;

cbuffer ColorGradeParameters
{
    float PaletteIntensity;
    float Saturation;
    float Contrast;
    float Gamma;
    float2 InvResolution;
    float2 _Pad;
};

float3 ApplyLUT(float3 Color)
{
    uint Width = 0;
    uint Height = 0;
    PaletteLUTTexture.GetDimensions(Width, Height);
    if (Width == 0)
    {
        return Color;
    }

    float Lum = dot(Color, float3(0.2126, 0.7152, 0.0722));
    float2 LUTUV = float2(saturate(Lum), 0.5f);
    float4 LutColor = PaletteLUTTexture.SampleLevel(AnimeLinearClampSampler, LUTUV, 0);
    return lerp(Color, LutColor.rgb, PaletteIntensity);
}

float3 AdjustSaturation(float3 Color, float Sat)
{
    float Lum = dot(Color, float3(0.2126, 0.7152, 0.0722));
    return lerp(float3(Lum, Lum, Lum), Color, Sat);
}

float3 AdjustContrast(float3 Color, float Cont)
{
    return (Color - 0.5f) * Cont + 0.5f;
}

float3 AdjustGamma(float3 Color, float G)
{
    float SafeG = max(G, 1e-3f);
    return pow(max(Color, 0.0f), 1.0f / SafeG);
}

[numthreads(THREADS_X, THREADS_Y, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint Width = 0;
    uint Height = 0;
    OutputTexture.GetDimensions(Width, Height);
    uint2 PixelPos = DispatchThreadID.xy;

    if (PixelPos.x >= Width || PixelPos.y >= Height)
    {
        return;
    }

    float4 SceneColor = SceneColorTexture.Load(int3(PixelPos, 0));
    float3 Color = SceneColor.rgb;

    Color = ApplyLUT(Color);
    Color = AdjustSaturation(Color, Saturation);
    Color = AdjustContrast(Color, Contrast);
    Color = AdjustGamma(Color, Gamma);

    OutputTexture[PixelPos] = float4(saturate(Color), SceneColor.a);
}
