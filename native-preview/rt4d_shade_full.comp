#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Ray { vec3 origin; vec3 dir; };
struct Hit { float t; int triIndex; vec3 normal; };
struct Material {
    vec3 baseColor; float metallic;
    float roughness; float ior;
    vec3 emission; float emissionStrength;
    int bsdfType; int flags;
    vec3 pad0; float pad1;
};
struct Triangle { vec3 v0; vec3 v1; vec3 v2; int materialIndex; vec3 pad; };
struct Path { vec3 origin; vec3 dir; vec3 throughput; vec3 radiance; uint pixelIndex; uint bounce; };

layout(set = 1, binding = 1) buffer TrianglesBuffer { Triangle tris[]; };
layout(set = 1, binding = 2) buffer MaterialsBuffer { Material mats[]; };
layout(set = 2, binding = 0) buffer PathsBuffer { Path paths[]; };
layout(set = 2, binding = 1) buffer HitsBuffer { Hit hits[]; };
layout(set = 2, binding = 7) buffer CountersBuffer { uint activeCount; uint nextCount; };

const float PI = 3.14159265;
const int BSDF_DISNEY = 0;
const int BSDF_GGX = 1;
const int BSDF_GLASS = 2;
const int BSDF_THIN_GLASS = 3;
const int BSDF_DIFFUSE = 4;

vec3 sampleGGXVNDF(vec3 n, vec3 v, float alpha, uint seed) {
    vec3 up = abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(0,1,0);
    vec3 t = normalize(cross(up, n)); vec3 b = cross(n, t);
    vec3 vLocal = vec3(dot(v,t), dot(v,b), dot(v,n));
    float a = alpha;
    vec3 vHemi = normalize(vec3(a*vLocal.x, a*vLocal.y, vLocal.z));
    float u1 = float((seed*1664525u+1013904223u)&0x00FFFFFFu)/float(0x01000000u);
    float u2 = float((seed*22695477u+1u)&0x00FFFFFFu)/float(0x01000000u);
    float r = sqrt(u1); float phi = 2.0*PI*u2;
    float x = r*cos(phi); float y = r*sin(phi); float z = sqrt(max(0.0,1.0-x*x-y*y));
    vec3 hLocal = vec3(x,y,z);
    vec3 hHemi = normalize(vec3(a*hLocal.x, a*hLocal.y, max(0.0,hLocal.z)));
    return normalize(t*hHemi.x + b*hHemi.y + n*hHemi.z);
}

float ggxD(vec3 n, vec3 h, float alpha){ float NoH=max(dot(n,h),0.0); float a2=alpha*alpha; float d=(NoH*NoH*(a2-1.0)+1.0); return a2/(PI*d*d); }
float ggxPdf(vec3 n, vec3 v, vec3 h, float alpha){ float D=ggxD(n,h,alpha); return (D*max(dot(n,h),0.0))/max(4.0*max(dot(v,h),0.0),1e-6); }

vec3 sampleGGXSpecular(vec3 n, vec3 v, float alpha, vec3 F0, uint seed, out vec3 l, out float pdf, out vec3 f){
    vec3 h = sampleGGXVNDF(n,v,alpha,seed); l = reflect(-v,h);
    float NoV=max(dot(n,v),0.0); float NoL=max(dot(n,l),0.0); float NoH=max(dot(n,h),0.0); float VoH=max(dot(v,h),0.0);
    if(NoL<=0.0){ pdf=0.0; f=vec3(0.0); return l; }
    float D=ggxD(n,h,alpha); float k=(alpha+1.0)*(alpha+1.0)/8.0;
    float Gv=NoV/(NoV*(1.0-k)+k); float Gl=NoL/(NoL*(1.0-k)+k); float G=Gv*Gl;
    float Fc=pow(1.0-VoH,5.0); vec3 F=F0+(1.0-F0)*Fc;
    f = (D*G*F)/max(4.0*NoV*NoL,1e-6); pdf=ggxPdf(n,v,h,alpha); return l;
}

vec3 disneyDiffuse(vec3 baseColor,float NoL,float NoV,float LoH){
    float FL=pow(1.0-NoL,5.0); float FV=pow(1.0-NoV,5.0);
    float Fd90=0.5+2.0*LoH*LoH; float Fd=mix(1.0,Fd90,FL)*mix(1.0,Fd90,FV);
    return baseColor*Fd/PI;
}

vec3 disneyF0(vec3 baseColor,float metallic,float ior){
    float F0d=((ior-1.0)/(ior+1.0)); F0d*=F0d; return mix(vec3(F0d),baseColor,metallic);
}

bool russianRoulette(inout vec3 thr, uint bounce, uint seed){
    if(bounce<3) return true;
    float p=max(max(thr.r,thr.g),thr.b); p=clamp(p,0.05,0.95);
    float u=float((seed*1664525u+1013904223u)&0x00FFFFFFu)/float(0x01000000u);
    if(u>p) return false; thr/=p; return true;
}

vec3 sampleGlass(Material mat,vec3 n,vec3 v,uint seed,out vec3 l,out float pdf,out vec3 f){
    float ior=mat.ior; float eta=dot(v,n)>0.0?1.0/ior:ior;
    float cosV=max(dot(v,n),0.0); float F0=((ior-1.0)/(ior+1.0)); F0*=F0;
    float F=F0+(1.0-F0)*pow(1.0-cosV,5.0);
    float u=float((seed*1664525u+1013904223u)&0x00FFFFFFu)/float(0x01000000u);
    if(u<F){ l=reflect(-v,n); pdf=F; f=vec3(F)/max(pdf,1e-6); return l; }
    vec3 refr; bool ok=refract(ok?refr:refr,-v,n,eta)?true:false;
    // simplified
    l=reflect(-v,n); pdf=1.0-F; f=vec3(1.0)*(1.0-F)*ior*ior/max(pdf,1e-6); return l;
}

void main(){
    uint idx=gl_GlobalInvocationID.x;
    if(idx>=activeCount) return;
    Path p=paths[idx];
    Hit hit=hits[idx];
    if(hit.triIndex<0){
        paths[idx]=p; return;
    }
    Triangle tri=tris[hit.triIndex];
    Material mat=mats[tri.materialIndex];
    vec3 n=normalize(hit.normal);
    vec3 v=normalize(-p.dir);
    vec3 hitPos=p.origin+p.dir*hit.t;
    uint seed=uint(p.pixelIndex)^p.bounce;
    if(!russianRoulette(p.throughput,p.bounce,seed)){ paths[idx]=p; return; }
    vec3 l; float pdf; vec3 f;
    if(mat.bsdfType==BSDF_DISNEY){
        // simplified Disney
        float alpha=mat.roughness*mat.roughness; vec3 F0=disneyF0(mat.baseColor,mat.metallic,mat.ior);
        sampleGGXSpecular(n,v,alpha,F0,seed,l,pdf,f);
    }else if(mat.bsdfType==BSDF_GLASS){
        sampleGlass(mat,n,v,seed,l,pdf,f);
    }else{
        l=normalize(sampleGGXVNDF(n,v,0.5,seed));
        pdf=max(dot(n,l),0.0)/PI; f=mat.baseColor/PI;
    }
    float NoL=max(dot(n,l),0.0);
    if(NoL<=0.0||pdf<=0.0){ paths[idx]=p; return; }
    p.throughput*=f*NoL/pdf;
    p.radiance+=p.throughput*mat.emission*mat.emissionStrength;
    p.origin=hitPos+n*1e-3; p.dir=l; p.bounce++;
    paths[idx]=p;
    uint outIdx=atomicAdd(nextCount,1u);
    paths[outIdx]=p;
}
