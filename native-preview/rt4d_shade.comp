#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Ray {
    vec3 origin;
    vec3 dir;
};

struct Hit {
    float t;
    int   triIndex;
    vec3  normal;
};

struct Material {
    vec3 albedo;
    float roughness;
    float metallic;
    int  type;
    vec3 pad;
};

struct Triangle {
    vec3 v0;
    vec3 v1;
    vec3 v2;
    int  materialIndex;
    vec3 pad;
};

layout(set = 1, binding = 1) buffer TrianglesBuffer {
    Triangle tris[];
};

layout(set = 1, binding = 2) buffer MaterialsBuffer {
    Material mats[];
};

layout(set = 2, binding = 0) buffer RaysBuffer {
    Ray rays[];
};

layout(set = 2, binding = 1) buffer HitsBuffer {
    Hit hits[];
};

layout(set = 2, binding = 2) buffer ThroughputBuffer {
    vec3 throughput[];
};

layout(set = 2, binding = 3) buffer RadianceBuffer {
    vec3 radiance[];
};

layout(set = 2, binding = 4) buffer RNGSeedsBuffer {
    uint seeds[];
};

vec3 sampleHemisphere(vec3 n, uint seed) {
    float u1 = float((seed * 1664525u + 1013904223u) & 0x00FFFFFFu) / float(0x01000000u);
    float u2 = float((seed * 22695477u + 1u) & 0x00FFFFFFu) / float(0x01000000u);

    float r = sqrt(max(0.0, 1.0 - u1 * u1));
    float phi = 2.0 * 3.14159265 * u2;

    vec3 local = vec3(r * cos(phi), u1, r * sin(phi));

    vec3 up = abs(n.y) < 0.999 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 t = normalize(cross(up, n));
    vec3 b = cross(n, t);

    return normalize(t * local.x + n * local.y + b * local.z);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    Hit hit = hits[idx];
    if (hit.triIndex < 0) {
        return;
    }

    Triangle tri = tris[hit.triIndex];
    Material mat = mats[tri.materialIndex];

    vec3 n = normalize(hit.normal);
    Ray ray = rays[idx];

    vec3 hitPos = ray.origin + ray.dir * hit.t;

    uint seed = seeds[idx];

    vec3 newDir = sampleHemisphere(n, seed);
    seeds[idx] = seed * 1664525u + 1013904223u;

    vec3 brdf = mat.albedo / 3.14159265;
    float cosTheta = max(0.0, dot(newDir, n));
    throughput[idx] *= brdf * cosTheta;

    radiance[idx] += throughput[idx] * vec3(0.0);

    rays[idx].origin = hitPos + n * 1e-3;
    rays[idx].dir    = newDir;

    hits[idx].t        = 1e30;
    hits[idx].triIndex = -1;
    hits[idx].normal   = vec3(0.0);
}
