#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    vec3 camPos;
    vec3 camForward;
    vec3 camRight;
    vec3 camUp;
    vec2 resolution;
    float time;
} camera;

layout(set = 0, binding = 1) uniform FrameUBO {
    uint frameIndex;
    uint sampleIndex;
    uint bounceIndex;
} frame;

layout(set = 0, binding = 2) buffer GlobalSettings {
    uint maxDepth;
    uint spp;
    uint flags;
} settings;

struct Ray {
    vec3 origin;
    vec3 dir;
};

layout(set = 2, binding = 0) buffer RaysBuffer {
    Ray rays[];
};

layout(set = 2, binding = 4) buffer RNGSeedsBuffer {
    uint seeds[];
};

uint pixelIndex(uvec2 pixel, uvec2 res) {
    return pixel.y * res.x + pixel.x;
}

vec2 sampleJitter(uint seed) {
    float x = float((seed * 1664525u + 1013904223u) & 0x00FFFFFFu) / float(0x01000000u);
    float y = float((seed * 22695477u + 1u) & 0x00FFFFFFu) / float(0x01000000u);
    return vec2(x, y);
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    uvec2 res = uvec2(camera.resolution);
    if (gid.x >= res.x || gid.y >= res.y) return;

    uint idx = pixelIndex(gid, res);

    uint seed = seeds[idx] ^ frame.sampleIndex ^ frame.frameIndex;
    vec2 jitter = sampleJitter(seed);

    vec2 uv = (vec2(gid) + jitter) / camera.resolution * 2.0 - 1.0;
    uv.y = -uv.y;

    vec3 forward = normalize(camera.camForward);
    vec3 right   = normalize(camera.camRight);
    vec3 up      = normalize(camera.camUp);

    float aspect = camera.resolution.x / camera.resolution.y;
    float fov = 1.0;

    vec3 dir = normalize(forward +
                         uv.x * aspect * right * fov +
                         uv.y * up * fov);

    rays[idx].origin = camera.camPos;
    rays[idx].dir    = dir;

    seeds[idx] = seed * 1664525u + 1013904223u;
}
