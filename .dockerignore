# Docker build context exclusions

# VCS
.git
.gitignore
.github

# opencode workspace (large, never in images)
/.opencode

# Large directories
/unreal
/unity
/4d-renderer/demo
/demo
/native
/native-preview

# Non-essential subdirs
/css
/cssv/client
/engine/test
/schemas
/ci
/constitution
/config

# Docs (large)
/docs
*.md
CITATION.cff
.zenodo.json

# Dependencies (fresh install)
node_modules
**/node_modules
**/.venv
**/__pycache__
**/node_modules

# Env/secrets
.env
.env.*
!.env.example

# Logs/temp
*.log
*.zip
/output
/tmp

# governed-render runtime artifacts (ledger, keys, renders)
/governed-render/output
/governed-render/data

# OS
.DS_Store
Thumbs.db
