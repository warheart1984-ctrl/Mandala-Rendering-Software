# Axiom-X .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.env
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.so
*.dll
*.dylib

# Test outputs
tmp/
*.log
*.json
evidence*.json

# Runtime assets the movie scripts need (re-include from *.json / lib/)
!mrs/packages/renderer-core/schemas/salt_map_anime_timeline.json
!mrs/packages/renderer-core/scripts/lib/rt4d-movie.js

# Cloud Agent environment config (must be tracked despite blanket *.json ignore)
!.cursor/environment.json

# Jarvis EMR MCP host config examples (blanket *.json ignore)
!jarvis-memoryboard/config/mcp-cursor.example.json
!jarvis-memoryboard/config/mcp-opencode.example.json
!.opencode/config.json

# HoloRT4D Spatial MCP package manifests (blanket *.json ignore)
!mrs/apps/spatial-tokenizer/mcp/package.json
!mrs/apps/spatial-tokenizer/mcp/package-lock.json
!mrs/apps/spatial-tokenizer/mcp/tsconfig.json

# Docker
.docker/

# Secrets (never commit!)
*.pem
*.key
*.crt
*.env
.env.local
.env.production

# Large files
*.png
*.jpg
*.mp4
*.mov
*.avi
*.mkv

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE specific
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Optional: keep these if you want to track
# docs/
# examples/
# H test output logs
conformance-out.txt
test-output.txt

# Training datasets (never commit)
Anime Pictures for training/

# Nested git worktrees (do not commit checkouts)
.worktrees/

# Fox fixture E2E smoke evidence (partial hull — not anatomical fox)
!docs/proofs/rt4d-fox-fixture-smoke/
!docs/proofs/rt4d-fox-fixture-smoke/**
!docs/proofs/rt4d-fox-fixture-smoke/**/*.json
!docs/proofs/rt4d-fox-fixture-smoke/**/*.png
!docs/proofs/rt4d-fox-fixture-smoke/**/*.glb

# Character production pipeline (Mandala + Simulation Chamber)
!character/**/*.json
!character/**/*.mjs
!character/**/*.wgsl
!character/**/*.md

