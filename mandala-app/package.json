{
  "name": "mandala-desktop",
  "version": "0.1.0",
  "description": "Mandala Lattice desktop app — constitutional SME runtime with local LRC rendering",
  "author": "Mandala Renderer",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win --config.win.signAndEditExecutable=false",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "build": {
    "appId": "com.mandala.renderer",
    "productName": "Mandala Renderer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "cloud-ai-client.js",
      "director-agent.js",
      "dep-compiler.js",
      "dep-scheduler.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../sme/dist",
        "to": "sme-dist",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!models/**",
          "!**/test/**",
          "!**/*.test.js"
        ]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Graphics",
      "maintainer": "Mandala Renderer"
    }
  },
  "allowScripts": {
    "electron@30.0.0": true
  }
}
