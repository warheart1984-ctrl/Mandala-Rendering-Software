{
  "name": "@sovereignx/ciems-engine",
  "version": "1.0.0",
  "description": "Constitutional Engine (4DCE) — browser host, CSSV ledger, conformance profile",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "init:cssv": "node scripts/init-cssv-ledger.mjs",
    "test": "node scripts/test-all.mjs",
    "test:conformance": "node scripts/test-conformance.mjs",
    "test:runtime-provenance": "node --test engine/runtime/test/*.test.js",
    "security-audit": "node scripts/genblaze/security-audit.mjs",
    "test:cql": "node scripts/test-cql.mjs",
    "test:ckl": "node scripts/test-ascension-ckl.mjs",
    "test:4d-renderer": "node scripts/test-4d-renderer.mjs",
    "test:solid-play": "node scripts/test-host-solid-play.mjs",
    "export:surfaces": "node scripts/export-surface-meshes.mjs",
    "render:4d": "node mrs/packages/renderer-core/src/cli.js render",
    "render:hcl-baseline": "node scripts/render-hyper-caustic-baseline.mjs --write-hashes",
    "test:bvh4d-gpu": "node scripts/test-bvh4d-gpu.mjs",
    "test:inspector4d": "node scripts/test-inspector4d.mjs",
    "inspector:ws": "node scripts/inspector-ws-server.mjs",
    "cssv:server": "node cssv/server.js",
    "serve": "node scripts/serve-static.mjs",
    "start": "node scripts/start-dev.mjs",
    "examples:gallery": "node examples/gallery/generate.mjs",
    "examples:bench": "node examples/benchmarks/bench-render.mjs",
    "test:examples": "node scripts/test-examples-smoke.mjs",
    "validate:world-document": "node scripts/validate-world-document.mjs",
    "link:mrs-shim": "node scripts/link-mrs-shim.mjs",
    "b2:smoke": "node mrs/packages/storage-b2/scripts/smoke.mjs",
    "b2:list": "node mrs/packages/storage-b2/scripts/list.mjs",
    "b2:upload": "node mrs/packages/storage-b2/scripts/upload.mjs",
    "b2:download": "node mrs/packages/storage-b2/scripts/download.mjs",
    "test:engine3d-core": "npm run test:engine3d --prefix mrs/packages/engine3d-core",
    "demo:engine3d-core": "npm run demo:engine3d --prefix mrs/packages/engine3d-core",
    "genblaze:media": "cd mrs/apps/genblaze-media && python -m uvicorn app.main:app --host 0.0.0.0 --port 8787",
    "flux:smoke": "node mrs/apps/genblaze-media/scripts/flux-smoke.mjs",
    "flux:smoke:py": "cd mrs/apps/genblaze-media && .venv/Scripts/python.exe scripts/flux_smoke.py",
    "operator:face-install": "node scripts/operator-face-install.mjs",
    "test:face": "npm run test:face --prefix mrs/packages/engine3d-core",
    "test:governance": "node --test engine/governance/test/*.test.js",
    "test:gpu": "node --test mrs/packages/renderer-core/test/gpu/gpu-core.test.js engine/constitution/test/gpu-constitution.test.js",
    "test:gpu-live": "node --test mrs/packages/renderer-core/test/gpu/gpu-live-*.test.js",
    "test:multihost": "node --test engine/constitution/test/multihost-constitution.test.js engine/runtime/test/BrowserRuntimeAdapter.host.test.js",
    "sync:surfaces": "node scripts/sync-surface-meshes.mjs",
    "build:renderer-web": "npm run build --prefix mrs/packages/renderer-web",
    "test:all": "node scripts/test-all.mjs && npm run test:governance && npm run test:conformance",
    "check:types": "node scripts/check-package-types.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:bump": "node scripts/release-version.mjs",
    "build:engine3d": "npm run build --prefix mrs/packages/engine3d-core",
    "check:nvidia-gpu-host": "node scripts/check-nvidia-gpu-host.mjs",
    "detect:gpu-backend": "python scripts/detect-gpu-backend.py",
    "test:sovereign-x-router": "npm test --prefix mrs/packages/sovereign-x-router",
    "sx:capabilities": "node sovereign-x/cli/sx-capabilities.js",
    "sx:flux-image": "node sovereign-x/cli/sx-flux-image.mjs",
    "sx:flux-image-batch": "node sovereign-x/cli/sx-flux-image-batch.mjs",
    "sx:face-creation": "node sovereign-x/cli/sx-face-creation.mjs",
    "test:sovereign-x-parity": "node --test sovereign-x/tests/gpuParitySuite.test.js",
    "test:sovereign-x-promotion": "node --test sovereign-x/tests/gpuIntegratorPromotion.test.js",
    "test:sovereign-x-sot": "node --test sovereign-x/tests/*.test.js"
  },
  "dependencies": {
    "4d-renderer": "file:./4d-renderer",
    "@mrs/renderer-core": "file:./mrs/packages/renderer-core",
    "@mrs/engine3d-core": "file:./mrs/packages/engine3d-core",
    "@mrs/storage-b2": "file:./mrs/packages/storage-b2"
  }
}
